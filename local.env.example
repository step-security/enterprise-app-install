# Copy this file to local.env (gitignored) and fill in real values.

# For GHES, set to your server hostname, e.g. ghes.company.com
# Leave empty (or unset) to use github.com
GHES_HOSTNAME=

# Path to the installer app's private key .pem file
INSTALLER_APP_PRIVATE_KEY_PATH=

# Client ID of the installer app (starts with Iv)
INSTALLER_APP_CLIENT_ID=

# Enterprise slug (from https://<host>/enterprises/YOUR-SLUG)
ENTERPRISE_SLUG=

# Client IDs of the target StepSecurity apps to install.
# - github.com: use the public StepSecurity app client IDs (provided by StepSecurity).
# - GHES: use the client IDs of the apps as registered on your GHES instance.
REGULAR_APP_CLIENT_ID=
ADVANCED_APP_CLIENT_ID=

# Set to "true" to only check installation status without installing
DRY_RUN=false
